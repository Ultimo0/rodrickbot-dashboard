# Connexion à ta base Postgres (Neon, gratuit et permanent — voir DEPLOY.md).
# Format fourni tel quel par Neon lors de la création du projet :
# postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Copie ce fichier en .env, puis choisis TOI-MÊME une valeur secrète pour
# DASHBOARD_API_KEY (n'importe quelle chaîne de caractères, ex: un mot de
# passe long généré aléatoirement). C'est cette même valeur qu'il faudra
# retaper dans le champ "Clé API" du site.
DASHBOARD_API_KEY=

# Requis pour les comptes utilisateurs — n'importe quelle longue chaîne
# aléatoire, différente de DASHBOARD_API_KEY. Sert à sécuriser les
# sessions de connexion.
SESSION_SECRET=

# Optionnel — port d'écoute du serveur (3000 par défaut si absent).
PORT=
